# ============================================================
# Pollinator — Complete Environment Variable Reference
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# ---- Database -----------------------------------------------
# Amazon RDS PostgreSQL connection string (or local for dev)
DATABASE_URL="postgresql://pollinator:dev_password_only@localhost:5432/pollinator"

# ---- Redis --------------------------------------------------
# Amazon ElastiCache Redis URL (or local for dev)
REDIS_URL="redis://localhost:6379"

# ---- WhatsApp / Meta ----------------------------------------
WHATSAPP_GRAPH_VERSION="v26.0"

# Public administrator address allowed to sign registry setup from MetaMask.
# Configure only after its owner and role have been confirmed. Not a private key.
DEPLOYMENT_ADMIN_ADDRESS=""
# Meta App webhook verification token (you choose this value)
WHATSAPP_VERIFY_TOKEN="your_custom_verify_token_here"
# Meta App secret for HMAC-SHA256 signature verification
WHATSAPP_APP_SECRET="your_meta_app_secret"
# WhatsApp Business phone number ID (from Meta Business Manager)
WHATSAPP_PHONE_ID="your_phone_number_id"
# Meta Graph API system user access token
WHATSAPP_ACCESS_TOKEN="your_system_user_access_token"

# ---- AWS ----------------------------------------------------
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="AKIAIOSFODNN7EXAMPLE"
AWS_SECRET_ACCESS_KEY="wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"

# ---- Blockchain Network Selection ---------------------------
# Set to "local" for Hardhat node (free gas, instant local dev)
# Set to "amoy" for Polygon Amoy testnet
BLOCKCHAIN_NETWORK="local"
NEXT_PUBLIC_BLOCKCHAIN_NETWORK="local"

# Local Blockchain (Hardhat node - http://127.0.0.1:8545)
LOCAL_RPC_URL="http://127.0.0.1:8545"
# LOCAL_CONTRACT_ADDRESS="<registry v2 address from deploy:local>"
# Explicit test relayer with no registry roles; setup-integration-chain writes account #7 privately.
# LOCAL_PRIVATE_KEY="<local test relayer key>"

# Polygon Amoy Testnet (prototype / staging; this is not mainnet)
# Public RPC or Alchemy / AWS AMB:
# The Polygon-operated Amoy RPC was retired in July 2026. Select a current provider.
POLYGON_RPC_URL="https://polygon-amoy.drpc.org"
# CONTRACT_ADDRESS="<new registry v2 address>"
# MetaMask deployment uses public DEPLOYMENT_ADMIN_ADDRESS above; no administrator key on the server.
# DEPLOYER_PRIVATE_KEY is only for an explicitly chosen legacy deployment CLI.
# RELAYER_ADDRESS="<approved public gas relayer address>"
# RELAYER_PRIVATE_KEY="<separate gas-paying key with no registry roles>"
# Operational actors must be distinct from each other and the administrator.
# Run npm run chain:worker as a separate process; confirmed receipts update the database.
# CHAIN_MAX_FEE_GWEI="100"
# LOCAL_TEST_SIGNING is intentionally absent. It is only set by isolated local demo setup.
# BEEKEEPER_ACTOR_ADDRESS="0x..."
# LAB_ACTOR_ADDRESS="0x..."
# PROCESSOR_ACTOR_ADDRESS="0x..."
# DISTRIBUTOR_ACTOR_ADDRESS="0x..."
# RETAILER_ACTOR_ADDRESS="0x..."

# ---- IPFS / Pinata ------------------------------------------
IPFS_GATEWAY="https://gateway.pinata.cloud/ipfs/"
# Pinata API JWT (get from pinata.cloud dashboard)
PINATA_JWT="your_pinata_jwt_token"

# ---- QR Anti-Clone ------------------------------------------
# Minimum 32 characters. Generate with: openssl rand -hex 32
QR_HMAC_SECRET="change_me_minimum_32_chars_for_hmac_security_please"

# ---- App URL ------------------------------------------------
# Used in QR code URL generation. Set to your deployed domain in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Production containers use a private runtime setting so one image can serve separate cluster origins.
# APP_ORIGIN="https://your-cluster.example"
# WHATSAPP_PUBLIC_NUMBER="<public contact number, optional; never the access token>"

# ---- IoT Devices --------------------------------------------
# Generate 32 random bytes as 64 hex characters; no default. Used to encrypt per-device keys.
# IOT_CREDENTIAL_KEY="<random 64-hex key>"
# Enroll each owner/device using npm run device:provision. No browser-shared device secret.
# IOT_MQTT_URL="mqtts://your-broker.example:8883"
# Stable client ID: reuse on restart, never concurrently across multiple bridge instances.
# IOT_MQTT_CLIENT_ID="honeychain-bridge-cluster-a"
# IOT_MQTT_CA="/run/secrets/mqtt-ca.crt"
# IOT_MQTT_CERT="/run/secrets/bridge.crt"
# IOT_MQTT_KEY="/run/secrets/bridge.key"
# Optional web phone relay, using its own MQTT client certificate (CN honeychain-gateway).
# IOT_GATEWAY_MQTT_URL="mqtts://your-broker.example:8883"
# IOT_GATEWAY_MQTT_CA="/run/secrets/mqtt-ca.crt"
# IOT_GATEWAY_MQTT_CERT="/run/secrets/gateway.crt"
# IOT_GATEWAY_MQTT_KEY="/run/secrets/gateway.key"

# ---- Optional image screening --------------------------------
# No healthy fallback when the endpoint is missing or unavailable.
# Uses the AWS SDK credential provider chain (prefer a service IAM role).
# VARROA_LAMBDA_FUNCTION="<your configured function name or ARN>"
# VARROA_MODEL_VERSION="<actual deployed model artifact version>"

# ---- Admin --------------------------------------------------
# Internal service key used by WhatsApp harvest/lab preparation (never a substitute for actor approval).
# Recall requires an administrator session and its actor signature, not this service key.
# Generate with: openssl rand -hex 32
ADMIN_API_KEY="change_me_admin_api_key_min_32_chars"

# ---- Dashboard Auth -----------------------------------------
# Secret for signing JWT session cookies on the web dashboard
# Generate with: openssl rand -hex 32
# Required: no default secret or persona login. Provision accounts with npm run account:provision.
JWT_SECRET="change_me_jwt_secret_min_32_chars_please"
