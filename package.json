    "build:workers": "tsc -p tsconfig.workers.json",
    "start:chain": "node build/workers/workers/chain.js",
    "start:mqtt": "node build/workers/workers/mqtt.js",
    "start:whatsapp": "node build/workers/workers/whatsapp.js",
    "cluster:prepare": "node scripts/prepare-cluster.cjs",
    "test:deployment": "node --test test/deployment.test.cjs",
